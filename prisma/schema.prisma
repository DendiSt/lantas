// Prisma Schema for LANTAS (Layanan Terpadu Administrasi Sekolah)
// Primary Entities: User (Siswa / Staf TU) & Request (Pengajuan Izin)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SECURITY
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALPHA
}

enum RequestType {
  SAKIT
  IZIN_PULANG
  IZIN_KELUARGA
  IZIN_KEGIATAN
  DISPENSASI
  TANPA_KETERANGAN
  LAINNYA
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Class {
  id                String   @id @default(cuid())
  name              String   @unique
  homeroomTeacherId String?  @unique
  homeroomTeacher   User?    @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  students          User[]   @relation("ClassStudents")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Subject {
  id          String       @id @default(cuid())
  name        String       @unique
  teachers    User[]       @relation("TeacherSubjects")
  attendances Attendance[]
}

model User {
  id              String    @id @default(cuid())
  name            String
  username        String    @unique
  password        String
  role            Role      @default(STUDENT)
  classId         String?
  class           Class?    @relation("ClassStudents", fields: [classId], references: [id])
  nisn            String?   @unique
  nip             String?
  address         String?
  phone           String?
  birthDate       DateTime?
  gender          String?
  parentName      String?
  avatarUrl       String?
  lastLogin       DateTime?
  profileCompleted Boolean   @default(false)
  status          String    @default("ACTIVE")
  
  homeroomClass   Class?     @relation("HomeroomTeacher")
  requests        Request[]  @relation("StudentRequests")
  reviewedRequests Request[] @relation("RequestReviewer")
  securityScans    Request[] @relation("SecurityScans")
  attendances     Attendance[] @relation("StudentAttendances")
  recordedAttendances Attendance[] @relation("TeacherAttendances")
  subjects        Subject[]  @relation("TeacherSubjects")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum DepartureStatus {
  PENDING
  FROM_SCHOOL
  FROM_HOME
}

model Request {
  id            String        @id @default(cuid())
  studentId     String
  student       User          @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  type          RequestType
  reason        String
  attachmentUrl String?       // Link/Path lampiran bukti (surat dokter/foto)
  status        RequestStatus @default(PENDING)
  rejectionNote String?
  reviewerId    String?
  reviewer      User?         @relation("RequestReviewer", fields: [reviewerId], references: [id])
  
  // Time duration (if null, means full day)
  startTime     String?
  endTime       String?
  
  // Security Gate Pass feature
  qrToken       String?       @unique
  scannedAt     DateTime?
  qrExpiresAt   DateTime?
  departureStatus DepartureStatus @default(PENDING)
  securityId    String?
  security      User?         @relation("SecurityScans", fields: [securityId], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  student     User             @relation("StudentAttendances", fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   String
  endTime     String
  subjectId   String?
  subject     Subject?         @relation(fields: [subjectId], references: [id])
  status      AttendanceStatus
  teacherId   String?
  teacher     User?            @relation("TeacherAttendances", fields: [teacherId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, date, startTime, endTime])
}

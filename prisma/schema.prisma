// Prisma Schema for LANTAS (Layanan Terpadu Administrasi Sekolah)
// Primary Entities: User (Siswa / Staf TU) & Request (Pengajuan Izin)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum RequestType {
  SAKIT
  IZIN_PULANG
  IZIN_KELUARGA
  IZIN_KEGIATAN
  DISPENSASI
  TANPA_KETERANGAN
  LAINNYA
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String    @id @default(cuid())
  name            String
  username        String    @unique
  password        String
  role            Role      @default(STUDENT)
  classId         String?
  nisn            String?   @unique
  nip             String?
  address         String?
  phone           String?
  birthDate       DateTime?
  gender          String?
  parentName      String?
  avatarUrl       String?
  profileCompleted Boolean   @default(false)
  requests        Request[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Request {
  id            String        @id @default(cuid())
  studentId     String
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type          RequestType
  reason        String
  attachmentUrl String?       // Link/Path lampiran bukti (surat dokter/foto)
  status        RequestStatus @default(PENDING)
  rejectionNote String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
